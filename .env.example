# Music Metadata Cleaner environment configuration

# Required for AcoustID audio fingerprint lookup.
# Create an API key at https://acoustid.org/
ACOUSTID_API_KEY=

# Optional for future YouTube-assisted song identification.
# Put the real key in .env only; do not commit API keys.
YOUTUBE_API_KEY=

# Optional paid fallback audio recognition via AudD.
# Put the real token in .env only; do not commit API tokens.
AUDD_API_TOKEN=
MUSIC_METADATA_CLEANER_FALLBACK_RECOGNITION_ENABLED=false
MUSIC_METADATA_CLEANER_FALLBACK_RECOGNITION_THRESHOLD=70
MUSIC_METADATA_CLEANER_FALLBACK_VERIFY_MEDIUM_CONFIDENCE=false
MUSIC_METADATA_CLEANER_MULTI_SEGMENT_RECOGNITION_ENABLED=true
MUSIC_METADATA_CLEANER_MAX_RECOGNITION_SEGMENTS=3

# Optional: spend YouTube quota even for already high-confidence matches.
MUSIC_METADATA_CLEANER_ALWAYS_USE_YOUTUBE_VERIFICATION=false

# Optional: search YouTube only below this confidence unless always verification is enabled.
MUSIC_METADATA_CLEANER_YOUTUBE_SEARCH_BELOW_CONFIDENCE=90

# Provider-friendly user agent. Prefer including contact info for MusicBrainz/LRCLIB etiquette.
MUSIC_METADATA_CLEANER_USER_AGENT=MusicMetadataCleaner/0.1 (you@example.com)

# Optional: explicit fpcalc executable path.
# If unset, the app expects fpcalc.exe to be available on PATH.
# Example:
# FPCALC_PATH=C:\Tools\chromaprint\fpcalc.exe
FPCALC_PATH=

# Optional: explicit ffmpeg executable path used only for temporary AudD clips.
# Example:
# FFMPEG_PATH=C:\Tools\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=

# Optional local defaults used by the app configuration layer.
MUSIC_METADATA_CLEANER_DEFAULT_MUSIC_FOLDER=
MUSIC_METADATA_CLEANER_FILENAME_FORMAT={artist} - {title}.mp3
MUSIC_METADATA_CLEANER_AUTO_APPLY_CONFIDENCE=95
MUSIC_METADATA_CLEANER_ENABLE_BACKUP=true
