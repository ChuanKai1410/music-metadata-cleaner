# Music Metadata Cleaner environment configuration

# Required for AcoustID audio fingerprint lookup.
# Create an API key at https://acoustid.org/
ACOUSTID_API_KEY=

# Provider-friendly user agent. Prefer including contact info for MusicBrainz/LRCLIB etiquette.
MUSIC_METADATA_CLEANER_USER_AGENT=MusicMetadataCleaner/0.1 (you@example.com)

# Optional: explicit fpcalc executable path.
# If unset, the app expects fpcalc.exe to be available on PATH.
# Example:
# FPCALC_PATH=C:\Tools\chromaprint\fpcalc.exe
FPCALC_PATH=

# Optional local defaults used by the app configuration layer.
MUSIC_METADATA_CLEANER_DEFAULT_MUSIC_FOLDER=
MUSIC_METADATA_CLEANER_FILENAME_FORMAT={artist} - {title}.mp3
MUSIC_METADATA_CLEANER_AUTO_APPLY_CONFIDENCE=95
MUSIC_METADATA_CLEANER_ENABLE_BACKUP=true
